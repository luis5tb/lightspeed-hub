# Build the manager binary
FROM registry.redhat.io/ubi9/go-toolset:9.8-1793736700 AS builder
ARG TARGETOS
ARG TARGETARCH

WORKDIR /workspace
COPY go.mod go.mod
COPY go.sum go.sum
RUN go mod download

COPY api/ api/
COPY cmd/ cmd/
COPY internal/ internal/

# this directory is checked by ecosystem-cert-preflight-checks task in Konflux
COPY LICENSE /licenses/

USER 0

RUN CGO_ENABLED=1 GOOS=${TARGETOS:-linux} GOARCH=${TARGETARCH} go build -a -tags strictfipsruntime -o manager ./cmd/

# Build the hub A2A adapter binary (optional component, nested module).
# Build context must contain a2a-adapter/ (with vendor/ generated by
# `go mod vendor`) and LICENSE — `make image-a2a-adapter` stages exactly that
# in .a2a-image-context/. Vendoring is required because the nested module's
# `replace` points lightspeed-agentic-operator/api at a sibling checkout that
# is not part of any repo-root build context.
FROM registry.redhat.io/ubi9/go-toolset:9.8-1793736700 AS a2a-adapter-builder
ARG TARGETOS
ARG TARGETARCH

WORKDIR /workspace/a2a-adapter
COPY a2a-adapter/ .

USER 0

RUN CGO_ENABLED=1 GOOS=${TARGETOS:-linux} GOARCH=${TARGETARCH} go build -mod=vendor -a -tags strictfipsruntime -o /workspace/hub-a2a-adapter ./cmd/hub-a2a-adapter

# Final image for the hub A2A adapter (multi-target: `docker build --target a2a-adapter .`).
FROM registry.redhat.io/ubi9/ubi-minimal:9.8-1793578971 AS a2a-adapter

WORKDIR /
COPY --from=a2a-adapter-builder /workspace/hub-a2a-adapter .
RUN mkdir /licenses
COPY LICENSE /licenses/.
LABEL name="openshift-lightspeed/lightspeed-hub-rhel9-a2a-adapter" \
      cpe="cpe:/a:redhat:openshift_lightspeed:2::el9" \
      com.redhat.component="openshift-lightspeed" \
      io.k8s.display-name="OpenShift Lightspeed Hub A2A Adapter" \
      summary="OpenShift Lightspeed Hub A2A adapter exposes the hub's AgenticRun machinery over the A2A protocol." \
      description="OpenShift Lightspeed Hub A2A adapter is an optional component of OpenShift Lightspeed that terminates A2A protocol traffic (behind the Praxis policy gateway) and maps it onto AgenticRun custom resources." \
      io.k8s.description="OpenShift Lightspeed Hub A2A adapter is an optional component of OpenShift Lightspeed for A2A protocol front-door access to agentic runs." \
      io.openshift.tags="openshift-lightspeed,hub,a2a,ols"
USER 65532:65532

ENTRYPOINT ["/hub-a2a-adapter"]

FROM registry.redhat.io/ubi9/ubi-minimal:9.8-1793578971

WORKDIR /
COPY --from=builder /workspace/manager .
RUN mkdir /licenses
COPY LICENSE /licenses/.
LABEL name="openshift-lightspeed/lightspeed-hub-rhel9-operator" \
      cpe="cpe:/a:redhat:openshift_lightspeed:2::el9" \
      com.redhat.component="openshift-lightspeed" \
      io.k8s.display-name="OpenShift Lightspeed Hub Operator" \
      summary="OpenShift Lightspeed Hub Operator manages multicluster spoke lifecycle and fleet coordination." \
      description="OpenShift Lightspeed Hub Operator runs on a central hub cluster and manages a fleet of spoke clusters for OpenShift Lightspeed multicluster operations." \
      io.k8s.description="OpenShift Lightspeed Hub Operator is a component of OpenShift Lightspeed for multicluster spoke management." \
      io.openshift.tags="openshift-lightspeed,hub,multicluster,ols"
USER 65532:65532

ENTRYPOINT ["/manager"]
